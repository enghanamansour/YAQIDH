# Copy this file to `.env` and fill it in. `.env` is in .gitignore, so it is never committed.
# Never put a real key in this example file.

# ---- Language model (Groq free tier). One key serves both models below. ----
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# The model that understands the finding and explains it. Change the name here to try another model.
# llama-3.3-70b-versatile is no longer offered on the free Groq tier; this one supports tool calling.
LLM_MODEL=openai/gpt-oss-120b

# Optional: rewrites the Arabic explanation in Saudi dialect. Leave it empty to turn this off.
DIALECT_MODEL=openai/gpt-oss-120b

# 1 = also send the finding's code snippet to the model (off by default).
SEND_SNIPPETS=0

# ---- Where evidence files and policies live ----
DATA_DIR=data/releases
HISTORY_DIR=data/history
POLICY_PATH=config/policy.yaml

# What the scanners look at (set here, never by the agent)
SCAN_TARGET=demo_app
# local = this machine scans SCAN_TARGET; ci = a GitHub Actions job scans the PR and sends the results (scripts/ci_scan.py)
SCAN_SOURCE=local
SEMGREP_RULES_DIR=config/semgrep-rules

# ---- The backend API (backend/) ----
# A password of your choice. Every request must send it in the X-API-Token header.
API_TOKEN=
EVIDENCE_PATH=data/evidence.jsonl

# ---- External MCP servers / posting the comment and status on GitHub ----
GITHUB_TOKEN=
# GITHUB_MCP=1 posts the PR comment through the GitHub MCP server (GITHUB_MCP_COMMAND, default: its docker image).
GITHUB_MCP=0
# The secret you type in the GitHub webhook settings. The API refuses any event not signed with it.
GITHUB_WEBHOOK_SECRET=
NOTION_TOKEN=

# ---- The dashboard in live mode (python frontend-preview/server.py --live --api-url http://127.0.0.1:8000) ----
YAQIDH_API_TOKEN=
